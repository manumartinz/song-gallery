# Credenciales de tu app en https://developer.spotify.com/dashboard
# Copia este archivo a .env.local y rellena los valores.
# NUNCA se exponen al navegador: solo las lee la funcion serverless de /api.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: "lo que estoy escuchando" (/api/now), la fuente "mi mes"
# (/api/mine) y `npm run recs add`. Sale con `npm run spotify-token`.
# Sin ella, la web simplemente no muestra esas partes.
SPOTIFY_REFRESH_TOKEN=

# Opcional: la playlist pública a la que /admin y `npm run recs add` mandan las
# recomendaciones que apruebo. Se crea a mano en Spotify, una vez.
SPOTIFY_RECS_PLAYLIST=

# Opcional: la contraseña del panel /admin. Sin ella (o sin Redis) el panel no
# existe: /api/admin responde 404.
ADMIN_PASSWORD=

# Opcional: la búsqueda por ánimo con IA («¿qué querés escuchar?»). Key gratis
# de Gemini en https://aistudio.google.com/apikey. Necesita también el Redis de
# abajo. GEMINI_MODEL es opcional (por defecto gemini-flash-latest).
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional: reacciones y recomendaciones. Redis de Upstash (en Vercel: Storage /
# Marketplace -> Upstash, que crea estas dos solas). Sin ellas, esas partes de
# la web no aparecen.
KV_REST_API_URL=
KV_REST_API_TOKEN=
