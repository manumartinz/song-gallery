# Credenciales de tu app en https://developer.spotify.com/dashboard
# Copia este archivo a .env.local y rellena los valores.
# NUNCA se exponen al navegador: solo las lee la funcion serverless de /api.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: "lo que estoy escuchando" (/api/now). Sale con `npm run spotify-token`.
# Sin ella, la web simplemente no lo muestra.
SPOTIFY_REFRESH_TOKEN=
